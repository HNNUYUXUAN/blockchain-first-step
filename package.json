{
  "name": "blockchain-first-step",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "零基础中文区块链实验：仅使用本机 Hardhat EVM，无真实资产",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:api": "node server/index.mjs",
    "chain": "HARDHAT_DISABLE_TELEMETRY=true hardhat node --hostname 127.0.0.1 --port 8545 --network localDemo",
    "test": "npm run test:core && npm run test:ui",
    "test:backend": "node --test tests/backend.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "test:dom": "node --test tests/dom.test.mjs",
    "test:core": "npm run test:backend && npm run test:dom"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "hardhat": "3.18.1",
    "solc": "0.8.37"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "playwright": "1.61.1"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "license": "MIT"
}
